COMPANY_REGION="Umujyi wa Kigali"
NEXT_PUBLIC_COMPANY_REGION="Umujyi wa Kigali"
COMPANY_COUNTRY=RWANDA
NEXT_PUBLIC_COMPANY_COUNTRY=RWANDA
