# Resend email delivery
RESEND_API_KEY=re_your_resend_api_key
# Use a sender address on a domain verified in Resend, with SPF, DKIM, and DMARC configured.
EMAIL_FROM="Mountain Ceramic Company LTD <info@mountainceramic.com>"
EMAIL_REPLY_TO=info@mountainceramic.com
ADMIN_EMAIL=orders@mountainceramic.com
# Absolute writable persistent directory for uploaded media (outside public web root).
UPLOAD_STORAGE_DIR=/home/CPANEL_USER/private/mcc/uploads
# Generate a unique random value of at least 32 characters for the cPanel cron endpoint.
CONTACT_EMAIL_CRON_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
NEXT_PUBLIC_APP_NAME="Mountain Ceramic Company LTD"
NEXT_PUBLIC_COMPANY_NAME="Mountain Ceramic Company LTD"
NEXT_PUBLIC_SITE_NAME="Mountain Ceramics Company"
COMPANY_ADDRESS="Nyambuye, Muhanga District, Rwanda"
NEXT_PUBLIC_COMPANY_ADDRESS="Nyambuye, Muhanga District, Rwanda"
COMPANY_STREET_ADDRESS=Nyambuye
NEXT_PUBLIC_COMPANY_STREET_ADDRESS=Nyambuye
COMPANY_LOCALITY="Muhanga District"
NEXT_PUBLIC_COMPANY_LOCALITY="Muhanga District"
COMPANY_REGION=
NEXT_PUBLIC_COMPANY_REGION=
COMPANY_COUNTRY=Rwanda
NEXT_PUBLIC_COMPANY_COUNTRY=Rwanda
COMPANY_TIN=108383570
COMPANY_REGISTRATION_NUMBER=
COMPANY_PHONE=0798687945
NEXT_PUBLIC_COMPANY_PHONE=0798687945
COMPANY_PHONE_ALTERNATE=0781028738
NEXT_PUBLIC_COMPANY_PHONE_ALTERNATE=0781028738
COMPANY_EMAIL=info@mountainceramic.com
NEXT_PUBLIC_COMPANY_EMAIL=info@mountainceramic.com
COMPANY_SALES_EMAIL=sales@mountainceramic.com
NEXT_PUBLIC_COMPANY_SALES_EMAIL=sales@mountainceramic.com
NEXT_PUBLIC_COMPANY_BANK_NAME="Bank of Kigali"
NEXT_PUBLIC_COMPANY_BANK_ACCOUNT_NAME="Mountain Ceramic Company LTD"
NEXT_PUBLIC_COMPANY_BANK_ACCOUNT_NUMBER=100024581661
# Optional notes appear before the shared bank details in checkout, emails, and invoices.
NEXT_PUBLIC_INVOICE_PAYMENT_INSTRUCTIONS=

# Public canonical URL used for verification links.
NEXT_PUBLIC_SITE_URL=https://mountainceramic.example
# Optional absolute origin for requests to this Next.js app's /api routes.
# Set this before building for deployment; do not use localhost in production.
NEXT_PUBLIC_API_BASE_URL=https://mountainceramic.example
# Generate a unique random secret of at least 32 characters for signed invoice links.
INVOICE_URL_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# Generate with a cryptographically secure random generator; do not reuse either key.
OTP_SECRET=replace-with-at-least-32-random-characters
TWO_FACTOR_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
