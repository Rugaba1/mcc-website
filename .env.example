# SMTP email delivery (Nodemailer)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
# Use an address on a domain you control and have verified with your mail provider.
# Configure SPF, DKIM, and DMARC DNS records for that domain before production.
EMAIL_FROM="Mountain Ceramic Company LTD <info@mountainceramic.com>"
EMAIL_REPLY_TO=info@mountainceramic.com
ADMIN_EMAIL=orders@mountainceramic.com
# Generate a unique random value of at least 32 characters for the cPanel cron endpoint.
CONTACT_EMAIL_CRON_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
NEXT_PUBLIC_APP_NAME="Mountain Ceramic Company LTD"
NEXT_PUBLIC_COMPANY_NAME="Mountain Ceramic Company LTD"
COMPANY_ADDRESS="Kacyiru, Gasabo, Umujyi wa Kigali, RWANDA"
NEXT_PUBLIC_COMPANY_ADDRESS="Kacyiru, Gasabo, Umujyi wa Kigali, RWANDA"
COMPANY_STREET_ADDRESS=Kacyiru
NEXT_PUBLIC_COMPANY_STREET_ADDRESS=Kacyiru
